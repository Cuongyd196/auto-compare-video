VBEE_APP_ID=
VBEE_ACCESS_TOKEN=

# 0 (mặc định) = skill create-video dừng lại xin xác nhận người dùng ở các bước
#     chốt nội dung/kịch bản, xác nhận phát âm TTS, đổi độ dài ngoài 30-40s, trước khi render.
# 1 = skill create-video tự chạy toàn bộ quy trình không dừng lại hỏi, tới khi render xong video.
AUTO_CREATE_VIDEO=0

# Tên kênh/eyebrow tag hiển thị phía trên caption zone (#eyebrow) trong mọi video của series.
# Đổi giá trị này rồi chạy lại npm run dev/check/render (script scripts/sync-channel.mjs tự
# đồng bộ vào index.html trước mỗi lệnh, xem create-video skill).
CHANNEL=Cường IT

# Mã giọng đọc Vbee TTS dùng cho mọi video (đọc bởi scripts/generate-vo.mjs khi sinh VO).
# Xem danh sách alias/voice_code khác ở vbee.md § 5. Đổi giá trị này rồi chạy lại
# node scripts/generate-vo.mjs để sinh lại VO bằng giọng mới (không tự retroactive
# cho VO đã sinh trước đó).
# n_hanoi_male_protrainer_education_vc, n_hanoi_male_thangchuyennghiep_advertise_vc, 
# n_namdinh_male_haichuyen20251209185109485_book_vc, n_hanoi_male_sizonguyen_education_vc
# n_hanoi_female_nguyetnga2_book_vc, s_sg_male_thientam_ytstable_vc
VBEE_VOICE_CODE=n_hanoi_male_protrainer_education_vc