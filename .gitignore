# Dependencies
node_modules/

# Environment files — one shared .env at repo root (Vbee credentials); no leading
# slash, so this also catches an accidental .env dropped inside videos/<name>/
.env
.env.local
.env.*.local

# HyperFrames / editor caches — per video (videos/<name>/.hyperframes/ etc.),
# matched at any depth since these patterns have no leading slash
.hyperframes/
.thumbnails/
.waveform-cache/

# Render outputs and snapshots — per video, regenerated by `npm run render` /
# `hyperframes snapshot`, not committed
renders/
snapshots/

# Only these two videos are meant to be pushed to this repo; every other
# videos/<name>/ directory (new topics, experiments, etc.) stays local-only.
# Add a matching "!videos/<name>/" line here if another video should be shared.
videos/*
!videos/dev-vs-devops/
!videos/thien-thach-vs-sao-bang/

# Claude Code — project skills (.claude/skills/) ARE committed; only the
# machine-local settings override is not
.claude/settings.local.json

# Editor
.vscode/

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
